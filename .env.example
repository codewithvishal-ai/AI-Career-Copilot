# ==========================================
# AI CAREER COPILOT - ENVIRONMENT VARIABLES
# ==========================================


# GEMINI AI


GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash






# INTERVIEW

INTERVIEW_QUESTION_COUNT=10


GEMINI_QUOTA_COOLDOWN_SECONDS=900
ELEVENLABS_QUOTA_COOLDOWN_SECONDS=3600


# ==========================================
# ELEVENLABS
# ==========================================

ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_NAME=Sarah
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128



# AUTHENTICATION SECURITY


SECRET_KEY=CREATE_RANDOM_SECRET_KEY

# Authentication token lifetime in seconds.
AUTH_TOKEN_MAX_AGE=3600



# CORS

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,http://localhost:5000


# FLASK


# false for normal/production usage.
# true only for local development/debugging.
FLASK_DEBUG=false



# YOUTUBE

YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY





#MONGODB 
MONGODB_USERNAME="YOU_USERNAME"
MONGODB_PASSWORD="YOUR_PASSWORD"
MONGODB_URI=YOUR_MONGODB_URL
MONGODB_DATABASE=PASTE_YOUR_DATABASE_NAME
